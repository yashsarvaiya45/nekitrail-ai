PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# Gemini: optional at first. If absent, AI endpoint returns an explicitly labelled demo fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=180000

# PayPal Sandbox credentials. Keep these server-side; never put the secret in frontend/.env.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CURRENCY=USD

# MongoDB: optional. If absent, payment ledger operates in an in-memory development fallback.
MONGODB_URI=mongodb://localhost:27017/nekitrail

# Auditor Authentication: Server-side secret key for authorized human reviews and timeline audit entries.
# Never expose to the frontend. Generate a strong random key (e.g., node -e "console.log(crypto.randomBytes(32).toString('hex'))").
AUDITOR_SECRET_KEY=your_secure_auditor_secret_key_here
